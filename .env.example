# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_or_username_here

# Database configuration (Supabase PostgreSQL is optional, falls back to local SQLite if not provided)
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Imgflip credentials (for meme generation, optional)
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# Hugging Face configuration (optional, used for image generation)
HUGGINGFACE_API_KEY=

# Cloudflare Workers AI (optional, improves image generation reliability)
# Get from: https://dash.cloudflare.com → Workers & Pages → AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# App settings
ENVIRONMENT=development
AUTO_PUBLISH_THRESHOLD=90
QUEUE_THRESHOLD=70
PARSING_INTERVAL_HOURS=3.0
